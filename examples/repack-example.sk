# Example Skript for Repack. Copy it to plugins/Skript/scripts/ and run /sk reload repack-example.
# It uses the bundled "table" block (plugins/Repack/blocks/table.yml). Needs Skript 2.13 or newer.

# Any click on the table (left clicks too, since digging starts with one). The table's block file already stops the smithing table
# menu from opening, so this is where you would open your own menu.
on custom block interact of "table":
    send "&7You touched the table." to player

# Starting to dig a block: keep players without the right permission from breaking it.
on custom block break start of "table":
    if player does not have permission "example.table.break":
        cancel event
        send "&cOnly staff can take this table apart." to player

# Everything else that can happen to a block: here, tnt may destroy the table although the block file says it resists.
on custom block explode of "table":
    uncancel event

# The vanilla click event works as well, and tells right clicks apart from left clicks.
on right click:
    if event-block is a custom block with id "table":
        if player is sneaking:
            send "&7You peek under the table." to player
        else:
            send "&aThe infusion table hums." to player
            play sound "block.amethyst_block.chime" with volume 1 and pitch 1.2 at event-block
        if player's tool is a stick:
            send "Custom block id: %custom block id of event-block%" to player

# Handing out and placing blocks.
command /tablegive [<number=1>]:
    permission: example.table.give
    trigger:
        give player custom block item "table" x arg-1
        send "&aGave %arg-1% table(s)." to player

command /tableplace:
    permission: example.table.place
    trigger:
        set {_spot} to 2 meters in front of player
        place custom block "table" at {_spot} facing player's yaw

command /tableremove:
    permission: example.table.place
    trigger:
        set {_spot} to 2 meters in front of player
        remove custom block at {_spot}

command /customblocks:
    permission: example.table.give
    trigger:
        send "Custom blocks: %all custom block ids%" to player
